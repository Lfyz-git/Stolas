# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
STOLAS_API_TOKEN=
STOLAS_LISTEN=127.0.0.1
STOLAS_PORT=8080
STOLAS_PROJECT_NAME=stolas
